{
  "name": "patrickmschneider-website",
  "version": "1.0.0",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "build:all": "astro build && for t in $(cat previews.txt); do THEME=$t astro build && rm -rf dist/preview-$t/files dist/preview-$t/images || exit 1; done",
    "dev:a": "THEME=a astro dev",
    "dev:b": "THEME=b astro dev"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/newsreader": "5.3.0",
    "@fontsource-variable/source-serif-4": "5.3.1",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@fontsource/ibm-plex-sans": "5.3.0",
    "astro": "7.4.1",
    "yaml": "2.9.1"
  },
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.22.0"
  }
}
