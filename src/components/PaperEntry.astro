---
import { inlineMd, slug, type Paper } from '../lib/data';

interface Props {
  paper: Paper;
}
const { paper } = Astro.props;
const id = slug(paper.title);
const n = paper.coauthors.length;
const sep = (i: number) => (i < n - 2 ? ', ' : i === n - 2 ? (n > 2 ? ', and ' : ' and ') : '');
---

<article class="paper" id={id}>
  <div class="paper-meta">
    {paper.year && <span class="paper-year">{paper.year}</span>}
  </div>
  <div class="paper-body">
    <h3 class="paper-title">
      {paper.url ? <a href={paper.url}>{paper.title}</a> : paper.title}
    </h3>

    {n > 0 && (
      <p class:list={['paper-authors', { many: n > 4 }]}>
        with{' '}
        {paper.coauthors.map((c, i) => (
          <>{typeof c !== 'string' && c.url ? <a href={c.url}>{c.name}</a> : typeof c === 'string' ? c : c.name}{sep(i)}</>
        ))}
      </p>
    )}

    {(paper.venue || paper.note) && (
      <p class="paper-venue">
        {paper.venue && <span set:html={inlineMd(paper.venue)} />}
        {paper.note && <span class="paper-note" set:html={inlineMd(paper.note)} />}
      </p>
    )}

    <div class="paper-links">
      {paper.url && <a class="chip" href={paper.url}>Paper</a>}
      {paper.links.map((l) => <a class="chip" href={l.url}>{l.label}</a>)}
      {paper.abstract && (
        <button type="button" class="chip abstract-toggle" aria-expanded="false" aria-controls={`${id}-abstract`}>
          Abstract
        </button>
      )}
    </div>

    {paper.abstract && (
      <p class="paper-abstract" id={`${id}-abstract`} hidden>{paper.abstract}</p>
    )}
  </div>
</article>
