---
// One paper on the Research page: optional thumbnail | title (the main link), authors, venue,
// secondary links and abstract toggle | year on the right.
import { inlineMd, slug, type Paper } from '../lib/data';

interface Props {
  paper: Paper;
}
const { paper } = Astro.props;
const id = slug(paper.title);
const n = paper.coauthors.length;
const sep = (i: number) => (i < n - 2 ? ', ' : i === n - 2 ? (n > 2 ? ', and ' : ' and ') : '');
const hasExtras = paper.links.length > 0 || !!paper.abstract;
---

<article class:list={['paper', { 'has-thumb': !!paper.image }]} id={id}>
  {paper.image && (
    <a class="paper-thumb" href={paper.url ?? `#${id}`} tabindex="-1" aria-hidden="true">
      <img src={paper.image} alt="" loading="lazy" width="1200" height="675" />
    </a>
  )}
  <div class="paper-body">
    <h3 class="paper-title">
      {paper.url ? <a href={paper.url}>{paper.title}</a> : paper.title}
    </h3>

    {n > 0 && (
      <p class:list={['paper-authors', { many: n > 4 }]}>
        with{' '}
        {paper.coauthors.map((c, i) => (
          <>{typeof c !== 'string' && c.url ? <a href={c.url}>{c.name}</a> : typeof c === 'string' ? c : c.name}{sep(i)}</>
        ))}
      </p>
    )}

    {(paper.venue || paper.note) && (
      <p class="paper-venue">
        {paper.venue && <span set:html={inlineMd(paper.venue)} />}
        {paper.note && <span class="paper-note" set:html={inlineMd(paper.note)} />}
      </p>
    )}

    {hasExtras && (
      <p class="paper-links">
        {paper.links.map((l) => <a class="paper-link" href={l.url}>{l.label}</a>)}
        {paper.abstract && (
          <button type="button" class="paper-link abstract-toggle" aria-expanded="false" aria-controls={`${id}-abstract`}>
            Abstract
          </button>
        )}
      </p>
    )}

    {paper.coverage.length > 0 && (
      <p class="paper-coverage">
        <span class="coverage-label">Coverage</span>
        {paper.coverage.map((item) => <a href={item.url}>{item.label}</a>)}
      </p>
    )}

    {paper.abstract && (
      <p class="paper-abstract" id={`${id}-abstract`} hidden>{paper.abstract}</p>
    )}
  </div>
  {paper.year && <span class="paper-year">{paper.year}</span>}
</article>
