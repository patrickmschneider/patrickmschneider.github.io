---
// A card with a figure on top, used for featured papers and tools (home page and Tools page).
interface Props {
  href: string;
  title: string;
  image?: string;
  /** Status badge, e.g. { kind: 'working', label: 'Working paper' } */
  badge?: { kind: string; label: string };
  /** Journal name, shown in italics after the badge */
  journal?: string;
  /** A date or year, shown in monospace (e.g. "2026" or "Updated Nov 2026") */
  date?: string;
  text?: string;
  /** Optional link to the source code */
  source?: string;
  /** Description of the image for screen readers */
  alt?: string;
  /** Optional call-to-action text shown under the description, e.g. "Open tool" */
  cta?: string;
}
const { href, title, image, badge, journal, date, text, source, alt = '', cta } = Astro.props;
---

<li class="feature-card">
  <div class="feature-figure">
    {image && <img src={image} alt={alt} loading="lazy" width="1200" height="675" />}
  </div>
  {(badge || journal || date) && (
    <p class="feature-kicker">
      {badge && <span class:list={['badge', `badge-${badge.kind}`]}>{badge.label}</span>}
      {journal && <span class="feature-journal">{journal}</span>}
      {date && <span class="feature-date">{date}</span>}
    </p>
  )}
  <h3 class="feature-title"><a class="stretched" href={href}>{title}</a></h3>
  {text && <p class="feature-text">{text}</p>}
  {(cta || source) && (
    <p class="feature-actions">
      {cta && <span class="feature-cta" aria-hidden="true">{cta} →</span>}
      {source && <a class="feature-source" href={source}>Source on GitHub</a>}
    </p>
  )}
</li>
