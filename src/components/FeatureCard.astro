---
// A card with a figure on top, used for featured papers and tools on the home page.
interface Props {
  href: string;
  title: string;
  image?: string;
  kicker?: string;
  text?: string;
  /** Optional status badge shown before the kicker, e.g. { kind: 'working', label: 'Working paper' } */
  badge?: { kind: string; label: string };
}
const { href, title, image, kicker, text, badge } = Astro.props;
---

<li class="feature-card">
  <div class="feature-figure">
    {image && <img src={image} alt="" loading="lazy" />}
  </div>
  {(badge || kicker) && (
    <p class="feature-kicker">
      {badge && <span class:list={['badge', `badge-${badge.kind}`]}>{badge.label}</span>}
      {kicker && <span>{kicker}</span>}
    </p>
  )}
  <h3 class="feature-title"><a class="stretched" href={href}>{title}</a></h3>
  {text && <p class="feature-text">{text}</p>}
</li>
