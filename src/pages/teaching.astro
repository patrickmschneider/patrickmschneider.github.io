---
import Base from '../layouts/Base.astro';
import { teaching } from '../lib/data';
---

<Base title="Teaching">
  <h1>Teaching</h1>
  {teaching.map((inst) => (
    <section>
      <h2>{inst.institution}</h2>
      <ul class="course-list">
        {inst.courses.map((c) => (
          <li>
            <span class="course-title">
              {c.code && <span class="course-code">{c.code}</span>}
              {c.title}
            </span>
            {c.level && <span class="course-level">{c.level}</span>}
            {c.years && <span class="course-years">{c.years}</span>}
          </li>
        ))}
      </ul>
    </section>
  ))}
</Base>
