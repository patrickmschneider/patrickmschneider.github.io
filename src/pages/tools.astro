---
import Base from '../layouts/Base.astro';
import FeatureCard from '../components/FeatureCard.astro';
import { tools, liveTools } from '../lib/data';
---

<Base title="Tools">
  <div class="wrap wide reading">
    <h1 class="page-title">Tools</h1>
    {tools.intro && <p class="lede">{tools.intro}</p>}
    <ul class="feature-grid">
      {liveTools.map((t) => (
        <FeatureCard href={t.url!} title={t.title} image={t.image} date={t.updated && `Updated ${t.updated}`} text={t.description} source={t.source} />
      ))}
    </ul>
  </div>
</Base>
