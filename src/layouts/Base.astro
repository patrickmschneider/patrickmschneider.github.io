---
import '@theme/style.css';
import { profile } from '../lib/data';
import { page, isPreview, theme } from '../lib/url';

interface Props {
  title?: string;
  description?: string;
  isHome?: boolean;
}
const { title, description = profile.description, isHome = false } = Astro.props;
const fullTitle = title ? `${title} · ${profile.name}` : `${profile.name} · ${profile.affiliation}`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(profile.photo, Astro.site);

const nav = [
  { href: page('/research/'), label: 'Research' },
  { href: page('/teaching/'), label: 'Teaching' },
  { href: page('/tools/'), label: 'Tools' },
  ...(profile.cv ? [{ href: profile.cv, label: 'CV' }] : []),
];
const path = Astro.url.pathname.replace(/\/?$/, '/');
const home = page('/');
const isCurrent = (href: string) => path.startsWith(href);
---

<!doctype html>
<html lang="en-GB" data-theme={theme || 'site'}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="color-scheme" content="light dark" />
    <!-- Browser toolbar colour (Safari/Chrome): match the page, not the blue bar -->
    <meta name="theme-color" content="#faf9f6" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#121315" media="(prefers-color-scheme: dark)" />
    {isPreview && <meta name="robots" content="noindex" />}

    <meta property="og:type" content="website" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary" />
    <noscript><style>.paper-abstract[hidden] { display: block !important; } .abstract-toggle { display: none; }</style></noscript>
  </head>
  <body class:list={{ 'is-home': isHome }}>
    <a class="skip" href="#main">Skip to content</a>
    <header class="site-header">
      <div class="site-header-bar">
      <div class="wrap">
        <div class="brand">
          <a class="site-name" href={home}>{profile.name}</a>
          {profile.affiliation_url && (
            <a class="org-logo" href={profile.affiliation_url} aria-label={profile.affiliation}>
              <img src="/images/imperial-business-school-white.svg" alt={profile.affiliation} width="315" height="80" />
            </a>
          )}
        </div>
        <nav aria-label="Main">
          {nav.map((n) => (
            <a href={n.href} aria-current={isCurrent(n.href) ? 'page' : undefined}>{n.label}</a>
          ))}
        </nav>
      </div>
      </div>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="wrap">
        <span>{profile.address ?? profile.affiliation}</span>
        <span class="footer-links">
          <a href={`mailto:${profile.email}`}>{profile.email}</a>
          {profile.cv && <a href={profile.cv}>CV</a>}
        </span>
      </div>
    </footer>

    <script>
      // Abstract toggles: a button in the link row shows/hides the abstract below it.
      document.querySelectorAll<HTMLButtonElement>('.abstract-toggle').forEach((btn) => {
        btn.addEventListener('click', () => {
          const target = document.getElementById(btn.getAttribute('aria-controls')!);
          if (!target) return;
          const open = btn.getAttribute('aria-expanded') === 'true';
          btn.setAttribute('aria-expanded', String(!open));
          target.hidden = open;
        });
      });
    </script>
  </body>
</html>
