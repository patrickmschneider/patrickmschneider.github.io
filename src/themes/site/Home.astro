---
// Home page: hero (intro incl. a sentence pointing to the tools, photo blended into its backdrop),
// three featured papers, and news only when there is real news.
import Intro from '../../components/Intro.astro';
import FeatureCard from '../../components/FeatureCard.astro';
import { profile, papers, news, liveTools, inlineMd, paperStatus } from '../../lib/data';
import { page } from '../../lib/url';
import { createHash } from 'node:crypto';
import { readFileSync } from 'node:fs';

// Which headshot to show (files in public/images: <photo>.jpg and <photo>-860.jpg).
interface Props { photo?: string }
const { photo = 'headshot' } = Astro.props;
// Content hash in the URL so browsers fetch the new photo whenever the file changes.
const v = (file: string) =>
  createHash('md5').update(readFileSync(`public/images/${file}`)).digest('hex').slice(0, 8);
const big = `/images/${photo}.jpg?v=${v(`${photo}.jpg`)}`;
const small = `/images/${photo}-860.jpg?v=${v(`${photo}-860.jpg`)}`;
const mid = `/images/${photo}-1000.jpg?v=${v(`${photo}-1000.jpg`)}`;

const featured = papers.filter((p) => p.featured);
---

<section class="band">
  <div class="wrap wide band-inner">
    <Intro>
      {liveTools.length > 0 && (
        <p class="tools-line">
          I also build small public tools:{' '}
          {liveTools.map((t, i) => (
            <>
              <a href={t.url}>{t.title}</a>
              {i < liveTools.length - 2 ? ', ' : i === liveTools.length - 2 ? (liveTools.length > 2 ? ', and ' : ' and ') : '.'}
            </>
          ))}
        </p>
      )}
    </Intro>
    <img
      class="band-photo"
      src={big}
      srcset={`${small} 860w, ${mid} 1000w, ${big} 1600w`}
      sizes="(max-width: 64rem) 13rem, 28rem"
      alt={`Photo of ${profile.name}`}
      width="1600"
      height="1600"
      fetchpriority="high"
    />
  </div>
</section>

<section class="wrap wide block">
  <h2 class="label">Research</h2>
  <ul class="feature-grid">
    {featured.map((p) => (
      <FeatureCard href={p.url ?? page('/research/')} title={p.title} image={p.image} alt={`Figure from ${p.title}`} badge={paperStatus(p)} text={p.teaser} />
    ))}
  </ul>
  <p class="more"><a href={page('/research/')}>All research →</a></p>
</section>

{news.length > 0 && (
  <section class="wrap wide block">
    <h2 class="label">News</h2>
    <ol class="news">
      {news.map((n) => (
        <li><span class="news-date">{n.date}</span><span set:html={inlineMd(n.text)} /></li>
      ))}
    </ol>
  </section>
)}
