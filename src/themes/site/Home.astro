---
// Direction B, "Figure-led": full-width hero band holding the whole intro (name, statement, bio, links)
// with a large photo blended into the band, then figure cards for papers and tools, then news.
import Intro from '../../components/Intro.astro';
import FeatureCard from '../../components/FeatureCard.astro';
import { profile, papers, news, liveTools, inlineMd, paperStatus } from '../../lib/data';

// Which headshot to show (files in public/images: <photo>.jpg and <photo>-860.jpg).
interface Props { photo?: string }
const { photo = 'headshot' } = Astro.props;
// Content hash in the URL so browsers fetch the new photo whenever the file changes.
import { createHash } from 'node:crypto';
import { readFileSync } from 'node:fs';
const v = (file: string) =>
  createHash('md5').update(readFileSync(`public/images/${file}`)).digest('hex').slice(0, 8);
const big = `/images/${photo}.jpg?v=${v(`${photo}.jpg`)}`;
const small = `/images/${photo}-860.jpg?v=${v(`${photo}-860.jpg`)}`;
const featured = papers.filter((p) => p.featured);
---

<section class="band">
  <div class="wrap wide band-inner">
    <Intro />
    <img
      class="band-photo"
      src={big}
      srcset={`${small} 860w, ${big} 1600w`}
      sizes="(max-width: 52rem) 17rem, 26rem"
      alt={`Photo of ${profile.name}`}
      width="1600"
      height="1600"
      fetchpriority="high"
    />
  </div>
</section>

<section class="wrap wide block">
  <h2 class="label">Research</h2>
  <ul class="feature-grid">
    {featured.map((p) => (
      <FeatureCard href={p.url ?? '#'} title={p.title} image={p.image} badge={paperStatus(p)} journal={p.journal} date={p.journal ? undefined : p.year?.toString()} text={p.teaser} />
    ))}
  </ul>
  <h2 class="label">Tools</h2>
  <ul class="feature-grid">
    {liveTools.map((t) => (
      <FeatureCard href={t.url!} title={t.title} image={t.image} date={t.updated && `Updated ${t.updated}`} text={t.description} />
    ))}
  </ul>
</section>

{news.length > 0 && (
  <section class="wrap wide block news-block">
    <h2 class="label">News</h2>
    <ol class="news">
      {news.map((n) => (
        <li><span class="news-date">{n.date}</span><span set:html={inlineMd(n.text)} /></li>
      ))}
    </ol>
  </section>
)}
