---
// Direction B, "Figure-led": full-width hero band holding the whole intro (name, statement, bio, links)
// with a large photo blended into the band, then figure cards for papers and tools, then news.
import Intro from '../../components/Intro.astro';
import FeatureCard from '../../components/FeatureCard.astro';
import { profile, papers, news, liveTools, inlineMd, paperStatus } from '../../lib/data';

const featured = papers.filter((p) => p.featured);
---

<section class="band">
  <div class="wrap wide band-inner">
    <Intro />
    <img class="band-photo" src={profile.photo} alt={`Photo of ${profile.name}`} width="790" height="800" />
  </div>
</section>

<section class="wrap wide block">
  <h2 class="label">Research</h2>
  <ul class="feature-grid">
    {featured.map((p) => (
      <FeatureCard href={p.url ?? '#'} title={p.title} image={p.image} badge={paperStatus(p)} kicker={p.journal ?? (p.year ? String(p.year) : undefined)} text={p.teaser} />
    ))}
  </ul>
  <h2 class="label">Tools</h2>
  <ul class="feature-grid">
    {liveTools.map((t) => (
      <FeatureCard href={t.url!} title={t.title} image={t.image} kicker="Tool" text={t.description} />
    ))}
  </ul>
</section>

{news.length > 0 && (
  <section class="wrap wide block news-block">
    <h2 class="label">News</h2>
    <ol class="news">
      {news.map((n) => (
        <li><span class="news-date">{n.date}</span><span set:html={inlineMd(n.text)} /></li>
      ))}
    </ol>
  </section>
)}
